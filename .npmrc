# Expo SDK 57 pins react@19.2.3, but transitive devtools packages pull
# react-dom@19.2.8, which peer-requires react@^19.2.8. The mismatch is inside
# Expo's own tooling and does not affect the app bundle, so peer resolution is
# relaxed rather than force-upgrading React away from the version Expo tests.
legacy-peer-deps=true
